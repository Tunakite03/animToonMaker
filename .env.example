# AnimToon Maker - Environment Variables
# Copy this file to .env.local and fill in your API keys

# Option 1: fal.ai (fastest, recommended)
# FAL_KEY=your_fal_key_here

# Option 2: Replicate
# REPLICATE_API_TOKEN=your_replicate_token_here

# If neither key is set, the app will use colored placeholder images.
